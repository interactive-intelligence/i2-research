---
// Rocket ascending through a parallax starfield
---

<svg
  class="motif"
  viewBox="0 0 240 180"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g class="stars-far">
    <circle cx="20" cy="30" r="0.8" />
    <circle cx="55" cy="80" r="1" />
    <circle cx="90" cy="20" r="0.7" />
    <circle cx="130" cy="55" r="0.9" />
    <circle cx="170" cy="120" r="0.8" />
    <circle cx="210" cy="35" r="1.1" />
    <circle cx="40" cy="150" r="0.7" />
    <circle cx="180" cy="160" r="0.8" />
  </g>
  <g class="stars-near">
    <circle cx="35" cy="55" r="1.4" />
    <circle cx="105" cy="100" r="1.6" />
    <circle cx="155" cy="40" r="1.3" />
    <circle cx="200" cy="90" r="1.5" />
    <circle cx="75" cy="135" r="1.2" />
    <circle cx="220" cy="155" r="1.4" />
  </g>

  <g class="trail">
    <line x1="120" y1="160" x2="160" y2="200" />
    <line x1="115" y1="155" x2="145" y2="195" />
    <line x1="125" y1="155" x2="175" y2="195" />
  </g>

  <g transform="translate(120 90) rotate(-45)">
    <g class="rocket">
      <path
        class="body"
        d="M 0 -22 L 6 -8 L 6 14 L -6 14 L -6 -8 Z"
      />
      <circle class="window" cx="0" cy="-2" r="2.4" />
      <path
        class="fin-l"
        d="M -6 8 L -12 18 L -6 18 Z"
      />
      <path
        class="fin-r"
        d="M 6 8 L 12 18 L 6 18 Z"
      />
      <path
        class="flame"
        d="M -4 14 Q 0 26 4 14 Q 2 22 0 14 Q -2 22 -4 14 Z"
      />
    </g>
  </g>
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
    color: var(--card-color, currentColor);
    overflow: hidden;
  }

  .stars-far circle {
    fill: currentColor;
    opacity: 0.3;
  }
  .stars-near circle {
    fill: currentColor;
    opacity: 0.55;
  }

  .trail line {
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    opacity: 0.35;
    stroke-dasharray: 4 6;
  }

  .rocket .body {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linejoin: round;
    opacity: 0.85;
  }
  .rocket .window {
    fill: currentColor;
    opacity: 0.7;
  }
  .rocket .fin-l,
  .rocket .fin-r {
    fill: currentColor;
    opacity: 0.55;
  }
  .rocket .flame {
    fill: currentColor;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: no-preference) {
    .stars-far circle {
      animation: twinkle 3.6s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
    }
    .stars-near circle {
      animation: twinkle 2.8s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
    }
    .stars-far circle:nth-child(odd) { animation-delay: 0.6s; }
    .stars-far circle:nth-child(3n) { animation-delay: 1.4s; }
    .stars-near circle:nth-child(even) { animation-delay: 0.8s; }
    .stars-near circle:nth-child(3n) { animation-delay: 1.7s; }

    .rocket {
      animation: rocket-drift 5s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
      transform-box: fill-box;
      transform-origin: center;
    }

    .trail line {
      animation: trail-flow 1.6s linear infinite;
      animation-play-state: var(--motif-play, paused);
    }
    .trail line:nth-child(2) { animation-delay: 0.3s; }
    .trail line:nth-child(3) { animation-delay: 0.6s; }

    .rocket .flame {
      animation: flame-flicker 0.4s ease-in-out infinite alternate;
      animation-play-state: var(--motif-play, paused);
      transform-box: fill-box;
      transform-origin: center top;
    }
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.4); }
  }

  @keyframes rocket-drift {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  @keyframes trail-flow {
    0% {
      stroke-dashoffset: 0;
      opacity: 0.5;
    }
    100% {
      stroke-dashoffset: -20;
      opacity: 0.15;
    }
  }

  @keyframes flame-flicker {
    0% { transform: scaleY(1); opacity: 0.55; }
    100% { transform: scaleY(1.35); opacity: 0.85; }
  }

  .stars-far circle,
  .stars-near circle {
    transform-box: fill-box;
    transform-origin: center;
  }
</style>
