---
// Sine wave (continuous, biological) quantizing into step function (discrete, computational)
---

<svg
  class="motif"
  viewBox="0 0 240 180"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g class="waveforms">
    <path
      class="sine"
      d="M 0 90
         Q 15 50 30 90 T 60 90 T 90 90 T 120 90"
    />
    <path
      class="step"
      d="M 120 90
         L 130 90 L 130 60 L 145 60 L 145 110 L 160 110 L 160 70
         L 175 70 L 175 100 L 190 100 L 190 65 L 205 65 L 205 95
         L 220 95 L 220 90 L 240 90"
    />
  </g>

  <g class="tokens">
    <rect x="128" y="55" width="14" height="14" rx="2" />
    <rect x="143" y="105" width="14" height="14" rx="2" />
    <rect x="158" y="65" width="14" height="14" rx="2" />
    <rect x="173" y="95" width="14" height="14" rx="2" />
    <rect x="188" y="60" width="14" height="14" rx="2" />
    <rect x="203" y="90" width="14" height="14" rx="2" />
  </g>

  <g class="ticks">
    <line x1="120" y1="20" x2="120" y2="160" />
  </g>

  <g class="scanner">
    <line x1="0" y1="20" x2="0" y2="160" />
  </g>
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
    color: var(--card-color, currentColor);
    overflow: hidden;
  }

  .waveforms path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.7;
  }

  .tokens rect {
    fill: currentColor;
    opacity: 0;
    stroke: none;
  }

  .ticks line {
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-dasharray: 2 4;
    opacity: 0.35;
  }

  .scanner line {
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .scanner line {
      animation: scan 5s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
    }

    .tokens rect {
      animation: token-flash 5s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
      transform-box: fill-box;
      transform-origin: center;
    }
    .tokens rect:nth-child(1) { animation-delay: 2.5s; }
    .tokens rect:nth-child(2) { animation-delay: 2.7s; }
    .tokens rect:nth-child(3) { animation-delay: 2.9s; }
    .tokens rect:nth-child(4) { animation-delay: 3.1s; }
    .tokens rect:nth-child(5) { animation-delay: 3.3s; }
    .tokens rect:nth-child(6) { animation-delay: 3.5s; }

    .sine {
      animation: sine-shimmer 5s ease-in-out infinite;
      animation-play-state: var(--motif-play, paused);
    }
  }

  @keyframes scan {
    0%, 100% {
      transform: translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.55;
    }
    50% {
      transform: translateX(240px);
      opacity: 0.55;
    }
    60% {
      opacity: 0;
    }
  }

  @keyframes token-flash {
    0%, 100% {
      opacity: 0;
      transform: scale(0.85);
    }
    20% {
      opacity: 0.85;
      transform: scale(1);
    }
    50% {
      opacity: 0.25;
    }
  }

  @keyframes sine-shimmer {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 0.85; }
  }
</style>
