---
// Dendritic tree with a synaptic pulse traveling down branches
---

<svg
  class="motif"
  viewBox="0 0 240 180"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  <g class="dendrites">
    <path d="M 20 90 Q 60 90 100 80 T 180 70" />
    <path d="M 100 80 Q 120 60 150 40 T 220 25" />
    <path d="M 100 80 Q 130 95 160 110 T 230 130" />
    <path d="M 60 90 Q 65 110 70 135 T 80 165" />
    <path d="M 140 50 Q 145 35 155 20" />
    <path d="M 170 105 Q 185 115 200 130" />
    <path d="M 80 85 Q 70 70 55 55" />
  </g>
  <g class="terminals">
    <circle cx="180" cy="70" r="2.5" />
    <circle cx="220" cy="25" r="2.5" />
    <circle cx="230" cy="130" r="2.5" />
    <circle cx="80" cy="165" r="2.5" />
    <circle cx="155" cy="20" r="2.5" />
    <circle cx="200" cy="130" r="2.5" />
    <circle cx="55" cy="55" r="2.5" />
  </g>
  <g class="soma">
    <circle cx="20" cy="90" r="6" />
  </g>
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
    color: var(--card-color, currentColor);
    overflow: visible;
  }

  .dendrites path {
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-linecap: round;
    fill: none;
    opacity: 0.35;
    stroke-dasharray: 30 200;
    stroke-dashoffset: 200;
  }

  .terminals circle {
    fill: currentColor;
    opacity: 0.5;
  }

  .soma circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    opacity: 0.65;
  }

  @media (prefers-reduced-motion: no-preference) {
    .dendrites path {
      animation: pulse-travel 4s ease-in-out infinite;
    }
    .dendrites path:nth-child(1) { animation-delay: 0s; }
    .dendrites path:nth-child(2) { animation-delay: 0.6s; }
    .dendrites path:nth-child(3) { animation-delay: 1.2s; }
    .dendrites path:nth-child(4) { animation-delay: 0.9s; }
    .dendrites path:nth-child(5) { animation-delay: 1.5s; }
    .dendrites path:nth-child(6) { animation-delay: 1.8s; }
    .dendrites path:nth-child(7) { animation-delay: 0.3s; }

    .terminals circle {
      animation: terminal-burst 4s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    .terminals circle:nth-child(1) { animation-delay: 1.6s; }
    .terminals circle:nth-child(2) { animation-delay: 2.2s; }
    .terminals circle:nth-child(3) { animation-delay: 2.8s; }
    .terminals circle:nth-child(4) { animation-delay: 2.5s; }
    .terminals circle:nth-child(5) { animation-delay: 3.1s; }
    .terminals circle:nth-child(6) { animation-delay: 3.4s; }
    .terminals circle:nth-child(7) { animation-delay: 1.9s; }

    .soma circle {
      animation: soma-breathe 3.4s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
  }

  @keyframes pulse-travel {
    0%, 100% {
      stroke-dashoffset: 200;
      opacity: 0.2;
    }
    40% {
      opacity: 0.95;
    }
    100% {
      stroke-dashoffset: -50;
    }
  }

  @keyframes terminal-burst {
    0%, 100% {
      opacity: 0.3;
      transform: scale(1);
    }
    20% {
      opacity: 1;
      transform: scale(1.8);
    }
    40% {
      opacity: 0.4;
      transform: scale(1);
    }
  }

  @keyframes soma-breathe {
    0%, 100% {
      transform: scale(1);
      opacity: 0.6;
    }
    50% {
      transform: scale(1.15);
      opacity: 0.95;
    }
  }
</style>
